{
  "name": "portal-gate-bkhit-sulut",
  "private": true,
  "version": "2.0.0",
  "description": "Geo-Aware Digital Gateway untuk Akses Layanan dan Informasi BKHIT Sulawesi Utara",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "analytics:sample": "node scripts/generate-sample-events.mjs",
    "analytics:aggregate": "node scripts/aggregate-analytics.mjs",
    "audit:release": "node scripts/release-audit.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}

