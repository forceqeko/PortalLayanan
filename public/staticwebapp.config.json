{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/asset/*", "/hero/*", "/content/*", "*.css", "*.js", "*.png", "*.svg", "*.json"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}

