# Konfigurasi Publik Portal Gate BKHIT Sulawesi Utara
# Catatan Keamanan (ARCH-08 / UAT-20): Jangan pernah menaruh API Secret / Token Rahasia pada variabel VITE_*

# --- Integrasi Sanity.io Headless CMS (Phase 4B) ---
# Kosongkan VITE_SANITY_PROJECT_ID jika ingin menggunakan data lokal (public/content/sample.json)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-02-01

# --- Fallback Sumber Konten JSON Statis ---
# VITE_CONTENT_PROJECTION_URL=/content/sample.json

# --- EndpointLayanan Resmi BKHIT ---
VITE_PTK_URL=https://ptk.karantinaindonesia.go.id/
VITE_QDI_URL=https://qdi.karantinaindonesia.go.id/
VITE_QDI_DEEPLINK_ENABLED=false
VITE_INFO_URL=https://karantinaindonesia.go.id/
VITE_WA_URL=https://wa.me/6282190899090?text=Halo%20BKHIT%20Sulawesi%20Utara%2C%20saya%20ingin%20bertanya%20mengenai%20layanan%20karantina.

